rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sellers: Read/Write only by owner
    match /sellers/{seller_uid} {
      allow read, write: if request.auth != null && request.auth.uid == seller_uid;
    }

    // Products: Public Read, Write by owner (who is referenced by seller_id)
    match /products/{product_id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.seller_id;
      // Allow updates/deletes if the existing document's seller_id matches the auth uid
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.seller_id;
    }

    // Orders: Read by owner, Write ONLY by Cloud Functions
    // Cloud Functions use the Admin SDK and bypass these rules entirely.
    match /orders/{stripe_pi_id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.seller_id;
      allow write: if false; 
    }
  }
}
